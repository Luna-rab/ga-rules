{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["infra/**"],
      "rules": {
        "no-new": "off"
      }
    },
    {
      "files": ["src/build/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "bun:sqlite",
                  "node:*",
                  "node:*/*",
                  "bun",
                  "bun/*",
                  "child_process",
                  "child_process/*",
                  "cluster",
                  "cluster/*",
                  "dgram",
                  "dgram/*",
                  "dns",
                  "dns/*",
                  "fs",
                  "fs/*",
                  "http",
                  "http/*",
                  "http2",
                  "http2/*",
                  "https",
                  "https/*",
                  "inspector",
                  "inspector/*",
                  "module",
                  "module/*",
                  "net",
                  "net/*",
                  "os",
                  "os/*",
                  "path",
                  "path/*",
                  "perf_hooks",
                  "perf_hooks/*",
                  "process",
                  "process/*",
                  "readline",
                  "readline/*",
                  "repl",
                  "repl/*",
                  "stream",
                  "stream/*",
                  "tls",
                  "tls/*",
                  "tty",
                  "tty/*",
                  "url",
                  "url/*",
                  "v8",
                  "v8/*",
                  "vm",
                  "vm/*",
                  "worker_threads",
                  "worker_threads/*",
                  "zlib",
                  "zlib/*",
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "drizzle-kit",
                  "drizzle-kit/*",
                  "**/infrastructure",
                  "**/infrastructure/**"
                ],
                "message": "domain/ は入出力をしない。bun・bun:sqlite・Node の組み込み・drizzle・infrastructure/ は infrastructure/ か build-index.ts で使う"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/domain/**", "src/server/presentation/markdown/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "bun:sqlite",
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "**/infrastructure",
                  "**/infrastructure/**"
                ],
                "message": "domain/ と presentation/markdown/ は DB を読まない。DB は infrastructure/sqlite/ で読み、presentation/mcp/tools/ から渡す"
              }
            ]
          }
        ]
      }
    }
  ],
  "options": {
    "typeAware": true,
    "denyWarnings": true
  }
}
