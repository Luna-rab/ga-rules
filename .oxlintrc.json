                "group": [
                  "bun:sqlite",
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "compromise",
                  "compromise/*",
                  "**/infrastructure",
                  "**/infrastructure/**"
                ],
                "message": "presentation/ は DB や実装を直接使わない。application/ のユースケースとポートを通す。実装は組み立て役（server/compose.ts）が渡す"
              },
              {
                "group": ["../**/build", "../**/build/**"],
                "message": "build/ と server/ は別の段に入るので、互いに import しない。共有するものは shared/ に置く"
