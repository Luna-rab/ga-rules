{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["infra/**"],
      "rules": {
        "no-new": "off"
      }
    },
    {
      "files": ["src/*/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "bun",
                  "bun/*",
                  "bun:*",
                  "node:*",
                  "node:*/*",
                  "child_process",
                  "child_process/*",
                  "cluster",
                  "cluster/*",
                  "dgram",
                  "dgram/*",
                  "dns",
                  "dns/*",
                  "fs",
                  "fs/*",
                  "http",
                  "http/*",
                  "http2",
                  "http2/*",
                  "https",
                  "https/*",
                  "inspector",
                  "inspector/*",
                  "module",
                  "module/*",
                  "net",
                  "net/*",
                  "os",
                  "os/*",
                  "path",
                  "path/*",
                  "perf_hooks",
                  "perf_hooks/*",
                  "process",
                  "process/*",
                  "readline",
                  "readline/*",
                  "repl",
                  "repl/*",
                  "stream",
                  "stream/*",
                  "tls",
                  "tls/*",
                  "tty",
                  "tty/*",
                  "url",
                  "url/*",
                  "v8",
                  "v8/*",
                  "vm",
                  "vm/*",
                  "worker_threads",
                  "worker_threads/*",
                  "zlib",
                  "zlib/*"
                ],
                "message": "domain/ は入出力をしない。bun・Node の組み込みは infrastructure/ で使う"
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "drizzle-kit",
                  "drizzle-kit/*",
                  "zod",
                  "zod/*",
                  "hono",
                  "hono/*",
                  "@modelcontextprotocol/**",
                  "compromise",
                  "compromise/*"
                ],
                "message": "domain/ はライブラリに縛られない。ライブラリは infrastructure/ か presentation/ で使い、domain/ には型と関数だけを置く"
              },
              {
                "group": [
                  "**/application",
                  "**/application/**",
                  "**/infrastructure",
                  "**/infrastructure/**",
                  "**/presentation",
                  "**/presentation/**"
                ],
                "message": "domain/ はほかの層を import しない。依存は外側の層から domain/ への一方向"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/*/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["bun", "bun/*", "bun:*", "node:*", "node:*/*"],
                "message": "application/ は入出力をしない。入出力は ports.ts の型を通し、実装は infrastructure/ に置く"
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "drizzle-kit",
                  "drizzle-kit/*",
                  "zod",
                  "zod/*",
                  "hono",
                  "hono/*",
                  "@modelcontextprotocol/**",
                  "compromise",
                  "compromise/*"
                ],
                "message": "application/ はライブラリに縛られない。ライブラリは infrastructure/ か presentation/ で使う"
              },
              {
                "group": [
                  "**/infrastructure",
                  "**/infrastructure/**",
                  "**/presentation",
                  "**/presentation/**"
                ],
                "message": "application/ は外側の層を import しない。実装は組み立て役（build/index.ts・server/index.ts）が渡す"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/*/presentation/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "bun:sqlite",
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "compromise",
                  "compromise/*",
                  "**/infrastructure",
                  "**/infrastructure/**"
                ],
                "message": "presentation/ は DB や実装を直接使わない。application/ のユースケースとポートを通す。実装は組み立て役（server/index.ts）が渡す"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/*/infrastructure/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/presentation", "**/presentation/**"],
                "message": "infrastructure/ は presentation/ を import しない。共有する型は domain/ か application/ に置く"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/__tests__/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/*/domain/**/__tests__/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "bun:sqlite",
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "**/infrastructure/sqlite",
                  "**/infrastructure/sqlite/**"
                ],
                "message": "domain/ のテストはデータを直接渡して確かめる。DB を通すテストは infrastructure/ か presentation/ に置く"
              }
            ]
          }
        ]
      }
    }
  ],
  "options": {
    "typeAware": true,
    "denyWarnings": true
  }
}
