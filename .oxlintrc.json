{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["infra/**"],
      "rules": {
        "no-new": "off"
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**/build", "../**/build/**", "../**/server", "../**/server/**"],
                "message": "shared/ は Docker の両方の段に入るので、build/ と server/ を import しない"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/build/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**/server", "../**/server/**"],
                "message": "build/ と server/ は別の段に入るので、互いに import しない。共有するものは shared/ に置く"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**/build", "../**/build/**"],
                "message": "build/ と server/ は別の段に入るので、互いに import しない。共有するものは shared/ に置く"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/*/domain/**", "src/*/application/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Bun",
            "message": "domain/ と application/ は入出力をしない。bun は infrastructure/ で使う"
          },
          {
            "name": "process",
            "message": "domain/ と application/ は環境変数や引数を読まない。組み立て役が読んで渡す"
          },
          {
            "name": "fetch",
            "message": "domain/ と application/ は通信しない。infrastructure/ で使う"
          }
        ]
      }
    },
    {
      "files": ["src/shared/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["bun", "bun/*", "bun:*", "node:*", "node:*/*"],
                "message": "domain/ は入出力をしない。bun・Node の組み込みは infrastructure/ で使う"
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/*",
                  "drizzle-kit",
                  "drizzle-kit/*",
                  "zod",
                  "zod/*",
                  "hono",
                  "hono/*",
                  "@modelcontextprotocol/**",
                  "compromise",
                  "compromise/*"
                ],
                "message": "domain/ はライブラリに縛られない。ライブラリは infrastructure/ か presentation/ で使い、domain/ には型と関数だけを置く"
              },
              {
                "group": [
                  "**/application",
                  "**/application/**",
                  "**/infrastructure",
                  "**/infrastructure/**",
                  "**/presentation",
                  "**/presentation/**"
                ],
                "message": "domain/ はほかの層を import しない。依存は外側の層から domain/ への一方向"
              },
              {
                "group": ["../**/build", "../**/build/**", "../**/server", "../**/server/**"],
                "message": "shared/ は Docker の両方の段に入るので、build/ と server/ を import しない"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/build/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["bun", "bun/*", "bun:*", "node:*", "node:*/*"],
